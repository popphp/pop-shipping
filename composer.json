{
    "name": "popphp/pop-shipping",
    "description": "Pop Shipping Component for Pop PHP Framework",
    "keywords": [
        "shipping api",
        "shipping rates",
        "track packages"
    ],
    "homepage": "https://github.com/popphp/pop-shipping",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Nick Sagona, III",
            "email": "nick@popphp.org",
            "homepage": "https://www.popphp.org/"
        }
    ],
    "require": {
        "php": ">=8.4.0",
        "popphp/pop-http": "^6.0.3",
        "popphp/pop-parser": "^1.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Pop\\Shipping\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pop\\Shipping\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.0.x-dev"
        }
    }
}
